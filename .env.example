# FastAPI chat server (same as Flutter AppConstants.chatServerUrl)
CHAT_SERVER_URL=https://chat.techoven.click

# Browser also needs this for /ws/visitor (live human replies)
NEXT_PUBLIC_CHAT_SERVER_URL=https://chat.techoven.click

# Same as FastAPI WORDPRESS_INTERNAL_SECRET — used to sync AI replies to Flutter
CHAT_INTERNAL_SECRET=change-me

# Public site key for THIS deployment / demo tenant (created via FastAPI internal API)
NEXT_PUBLIC_SITE_KEY=pk_live_replace_me

# Optional: show on the demo page
NEXT_PUBLIC_SITE_URL=https://example.com

# AI (pick one provider)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Knowledge base: if true, unanswered questions stay grounded (WP-style)
KB_REQUIRE_MATCH=true
# Protect POST/DELETE /api/kb in production
KB_ADMIN_SECRET=change-me
# Optional custom folder for articles JSON
# KB_DATA_DIR=
